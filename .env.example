DATABASE_URL=postgres://localhost:5432/wiggler

DEFAULT_ASSET=BTC
# Comma-separated wiggler symbols used by candles:sync when --symbols is omitted.
DEFAULT_SYMBOLS=BTC

COINBASE_REST_BASE_URL=https://api.exchange.coinbase.com
# Binance.com is geo-blocked from the US (HTTP 451). Default to Binance.US.
BINANCE_REST_BASE_URL=https://api.binance.us
BITSTAMP_REST_BASE_URL=https://www.bitstamp.net
BITFINEX_REST_BASE_URL=https://api-pub.bitfinex.com

# LOG_LEVEL=info
